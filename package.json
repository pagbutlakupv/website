{
  "name": "pagbutlak-website",
  "version": "1.0.0",
  "description": "Official website of Pagbutlak UPV",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "ci": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "prepare": "husky",
    "commit": "commit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@payloadcms/admin-bar": "^3.85.1",
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/live-preview-react": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/payload-cloud": "^3.85.1",
    "@payloadcms/plugin-form-builder": "^3.85.1",
    "@payloadcms/plugin-nested-docs": "^3.85.1",
    "@payloadcms/plugin-redirects": "^3.85.1",
    "@payloadcms/plugin-search": "^3.85.1",
    "@payloadcms/plugin-seo": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.90.0",
    "@payloadcms/ui": "^3.85.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/analytics": "^2.0.1",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "geist": "^1.7.0",
    "graphql": "^16.13.0",
    "lucide-react": "^0.378.0",
    "mime": "^4.1.0",
    "next": "15.5.24",
    "next-sitemap": "^4.2.3",
    "payload": "^3.85.1",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "7.45.4",
    "sharp": "0.35.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/prompt-cli": "^20.4.2",
    "@eslint/eslintrc": "^3.3.4",
    "@next/eslint-plugin-next": "15.5.19",
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.5.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.27",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.5.19",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.3",
    "jsdom": "26.1.0",
    "lint-staged": "^16.3.0",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "10.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "dompurify": ">=3.4.14",
      "postcss": ">=8.5.23",
      "undici": ">=7.29.0",
      "nodemailer": ">=9.0.1",
      "js-yaml": ">=4.3.1",
      "immutable": ">=4.3.9",
      "fast-uri": ">=3.1.5",
      "nanoid": ">=3.3.18",
      "brace-expansion": ">=5.0.9",
      "sharp": ">=0.35.0"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
